# SMTP-Konfiguration für Strato E-Mail-Versand
# WICHTIG: Diese Datei NICHT committen! Sie dient nur als Template.
# Die echten Werte müssen in Vercel als Environment Variables eingetragen werden.

# Strato SMTP Server (Standard-Werte)
SMTP_HOST=smtp.strato.de
SMTP_PORT=587

# Strato E-Mail Login-Daten
# Diese findest du im Strato Kundenservice-Bereich unter "E-Mail-Postfächer"
SMTP_USER=termin@zahnarztpraxis-schwabing.de
SMTP_PASS=dein-strato-smtp-passwort

# Absender-Adresse (sollte identisch mit SMTP_USER sein)
ABSENDER_EMAIL=termin@zahnarztpraxis-schwabing.de

# Empfänger-Adresse (Praxis-Empfang)
EMPFANG_EMAIL=empfang@zahnarztpraxis-schwabing.de
